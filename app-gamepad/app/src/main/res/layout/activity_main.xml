<?xml version="1.0" encoding="utf-8"?>
<!-- PlayStation (DualSense) düzeni: omuz tuşları üstte, D-pad + sol stick solda,
     sembol tuşları + sağ stick sağda, Share/PS/Options ortada, durum altta. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Omuz tuşları -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <Button
            android:id="@+id/btn_l1"
            android:layout_width="86dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_shoulders"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/btn_l1"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_l2"
            android:layout_width="86dp"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_shoulders"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/btn_l2"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_r2"
            android:layout_width="86dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_shoulders"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/btn_r2"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_r1"
            android:layout_width="86dp"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_shoulders"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/btn_r1"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Orta alan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Sol: D-pad + sol stick -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:columnCount="3"
                android:rowCount="3">

                <Button
                    android:id="@+id/btn_up"
                    android:layout_width="54dp"
                    android:layout_height="44dp"
                    android:layout_column="1"
                    android:layout_row="0"
                    android:background="@drawable/bg_dpad"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="▲"
                    android:textColor="@color/text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_left"
                    android:layout_width="54dp"
                    android:layout_height="44dp"
                    android:layout_column="0"
                    android:layout_row="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_dpad"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="◀"
                    android:textColor="@color/text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_right"
                    android:layout_width="54dp"
                    android:layout_height="44dp"
                    android:layout_column="2"
                    android:layout_row="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_dpad"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="▶"
                    android:textColor="@color/text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_down"
                    android:layout_width="54dp"
                    android:layout_height="44dp"
                    android:layout_column="1"
                    android:layout_row="2"
                    android:background="@drawable/bg_dpad"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="▼"
                    android:textColor="@color/text"
                    android:textSize="16sp" />
            </GridLayout>

            <io.github.strongbomber.blegamepad.JoystickView
                android:id="@+id/stick_left"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.15" />
        </LinearLayout>

        <!-- Orta: Share / PS / Options -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_share"
                android:layout_width="52dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_small"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/btn_share"
                android:textColor="@color/text_dim"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btn_ps"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_ps"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/btn_ps"
                android:textColor="@color/accent"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_options"
                android:layout_width="52dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_small"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/btn_options"
                android:textColor="@color/text_dim"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Sağ: sembol tuşları + sağ stick -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_triangle"
                    android:layout_width="56dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_face"
                    android:drawableTop="@drawable/ic_triangle"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="2dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_square"
                        android:layout_width="56dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_face"
                        android:drawableTop="@drawable/ic_square"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="2dp" />

                    <Space
                        android:layout_width="26dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btn_circle"
                        android:layout_width="56dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_face"
                        android:drawableTop="@drawable/ic_circle"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="2dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_cross"
                    android:layout_width="56dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_face"
                    android:drawableTop="@drawable/ic_cross"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <io.github.strongbomber.blegamepad.JoystickView
                android:id="@+id/stick_right"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.15" />
        </LinearLayout>
    </LinearLayout>

    <!-- Alt: durum + başlat/durdur -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/status_init"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_toggle"
            android:layout_width="170dp"
            android:layout_height="38dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_toggle"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/btn_start"
            android:textColor="#001A2E"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

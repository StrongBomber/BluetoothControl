# Local APK extraction / analysis artifacts (never commit expanded APK contents)
# — decompiled code of a closed-source app must not be redistributed.
# (kalıplar bilinçli olarak extracted/ ile sınırlıdır; uygulama kodu değil)
apk-analysis/
extracted/*
!extracted/ANALYSIS.md
extracted/*.dex
extracted/AndroidManifest.xml
extracted/resources.arsc
extracted/stamp-cert-sha256
extracted/cert_v2.der
extracted/cert_v3.der
extracted/cert_v4.der
extracted/manifest_dump.xml
extracted/secret_report.txt
extracted/sigblock.json

# Python
__pycache__/
*.pyc
*.pyo

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# CI byproducts
verify-report.json

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
